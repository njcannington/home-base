#!/usr/bin/env python3
# bin/hb
"""Executable shim. Keeps date.today() and sys.argv at the edge."""
import sys
from datetime import date
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT))

from homebase.cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:], ROOT, date.today()))
